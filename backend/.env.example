# Server
PORT=3000
NODE_ENV=production

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=web_survey_platform
DB_USER=surveyapp
DB_PASSWORD=GANTI_PASSWORD_DATABASE

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_JWT_SECRET_64_KARAKTER
SESSION_SECRET=GANTI_SESSION_SECRET_64_KARAKTER

# Redis
REDIS_URL=redis://redis:6379

# File Storage
UPLOAD_DIR=uploads/photos
MAX_FILE_SIZE_MB=5

# Frontend URL (untuk CORS)
FRONTEND_URL=https://survey.yourdomain.com

# Sentry Error Tracking (opsional — kosongkan untuk disable)
SENTRY_DSN=
