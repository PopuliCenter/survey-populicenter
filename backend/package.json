{
  "name": "web-survey-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for Web Survey Platform",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "worker": "node src/workers/index.js",
    "worker:dev": "nodemon src/workers/index.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@sentry/node": "^8.40.0",
    "archiver": "^7.0.1",
    "bcrypt": "5.1.1",
    "bullmq": "^5.25.5",
    "compression": "^1.8.0",
    "cors": "2.8.5",
    "csv-stringify": "6.4.6",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "7.3.1",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "morgan": "^1.10.1",
    "multer": "1.4.5-lts.1",
    "pg": "8.12.0",
    "pg-hstore": "2.3.4",
    "pptxgenjs": "^4.0.1",
    "rate-limit-redis": "4.2.0",
    "sequelize": "^6.37.8",
    "uuid": "9.0.1",
    "winston": "3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "fast-check": "3.20.0",
    "globals": "^15.12.0",
    "jest": "29.7.0",
    "nodemon": "3.1.4",
    "sequelize-cli": "6.6.2",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testPathPattern": "tests/.*\\.test\\.js$"
  }
}
