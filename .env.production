# ── Production Environment — Salin ke .env di VPS ──────────────────────────────

# Database
DB_PASSWORD=GANTI_PASSWORD_DATABASE_KUAT

# JWT — generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_JWT_SECRET
SESSION_SECRET=GANTI_SESSION_SECRET

# Frontend URL (untuk CORS) — boleh BANYAK domain dipisah koma (tanpa spasi).
# Selama migrasi domain, cantumkan domain lama & baru agar keduanya jalan:
FRONTEND_URL=https://risetcenter.com,https://www.risetcenter.com,https://populicenter.com,https://www.populicenter.com

# Sentry Error Tracking
# Buat project di https://sentry.io → Settings → Client Keys → Copy DSN
# Backend DSN (Node.js project):
SENTRY_DSN=
# Frontend DSN (React project) — set di frontend build:
# VITE_SENTRY_DSN=
