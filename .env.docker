# ── Docker Compose Environment ──────────────────────────────
# Salin file ini ke .env dan sesuaikan nilainya sebelum deploy

# Database
DB_PASSWORD=ganti_password_database_aman

# JWT — generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_jwt_secret_minimal_64_karakter
SESSION_SECRET=ganti_session_secret_minimal_64_karakter

# Frontend URL (untuk CORS) — sesuaikan dengan domain Anda
FRONTEND_URL=https://yourdomain.com
