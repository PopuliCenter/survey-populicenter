<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay manifest KHUSUS build Google Play (dipasang app/build.gradle saat
  bundleRelease / -PplayStore). Kebijakan Play melarang aplikasi memperbarui
  dirinya di luar Play, dan izin REQUEST_INSTALL_PACKAGES termasuk izin
  terbatas → dibuang di sini. Aplikasi lalu membuka halaman Play untuk update.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
</manifest>
