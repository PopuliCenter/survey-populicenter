<?xml version="1.0" encoding="utf-8"?>
<!--
  RILIS: TOLAK semua cleartext (HTTP). Server produksi (risetcenter.com) HTTPS,
  jadi seluruh trafik wajib terenkripsi — nol pengecualian di build rilis.
  Pengecualian server dev (10.0.2.2 / LAN / localhost) ada di varian DEBUG:
  app/src/debug/res/xml/network_security_config.xml (otomatis menimpa file ini
  hanya saat build debug).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
