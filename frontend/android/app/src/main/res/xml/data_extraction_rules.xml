<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+): kontrol cloud-backup & device-transfer.
  App ini menyimpan PII responden (antrian offline, IndexedDB) + token auth,
  jadi SEMUA data dikecualikan dari backup/transfer agar tidak bocor.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
