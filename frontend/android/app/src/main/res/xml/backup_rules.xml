<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 & lebih lama (fullBackupContent). allowBackup=false sudah
  mematikan backup, file ini sebagai penegas: tidak ada yang dicadangkan.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
