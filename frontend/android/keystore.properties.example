# ─── Template signing rilis Play Store ───────────────────────────────────────
#
# 1. SALIN file ini menjadi  keystore.properties  (TANPA .example) di folder
#    android/. File asli SUDAH di-gitignore — jangan pernah commit rahasia.
#
# 2. Buat upload keystore SEKALI (simpan aman + backup; kalau hilang, tidak bisa
#    update app yang sama kecuali pakai Play App Signing key reset):
#
#    keytool -genkey -v -keystore release.keystore \
#      -alias populi-survey -keyalg RSA -keysize 2048 -validity 10000
#
#    Taruh release.keystore di folder android/ (atau path lain, sesuaikan di bawah).
#
# 3. Isi nilai di bawah sesuai yang Anda masukkan saat keytool berjalan.
#
# 4. Build AAB rilis (akan otomatis ditandatangani):
#    cd android && ./gradlew bundleRelease
#    Output: app/build/outputs/bundle/release/app-release.aab
#
# 5. Daftarkan ke Play App Signing saat upload pertama (Google kelola signing key
#    final; keystore ini jadi "upload key").

# Path file keystore — relatif terhadap folder android/ (lokasi rootProject).
storeFile=release.keystore

# Password keystore (store).
storePassword=GANTI_DENGAN_PASSWORD_KEYSTORE

# Alias key yang dibuat dengan keytool (-alias).
keyAlias=populi-survey

# Password key (sering sama dengan storePassword).
keyPassword=GANTI_DENGAN_PASSWORD_KEY
