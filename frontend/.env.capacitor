# Environment variables untuk build Capacitor (Android APK)
# Salin ke .env.production sebelum build, atau set di CI/CD

# URL backend server — WAJIB diisi untuk native app
# Contoh: https://survey.populicenter.com
# Jika tidak diisi, user akan diminta input URL saat pertama kali buka app
# VITE_API_URL=https://survey.populicenter.com
